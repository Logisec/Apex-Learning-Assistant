{
    "manifest_version": 3,
    "name": "Apex Helper",
    "version": "1.0.1",
    "description": "Helps solve Apex Learning assessments",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://tutorials2.apexvs.com/*"
            ],
            "js": [
                "js/utils.js",
                "js/api.js",
                "js/solver.js",
                "js/ui.js",
                "js/content.js"
            ],
            "css": [
                "css/content.css"
            ]
        }
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "panel.html"
            ],
            "matches": [
                "*://tutorials2.apexvs.com/*"
            ]
        }
    ]
}